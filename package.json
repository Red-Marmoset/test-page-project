{
  "name": "test-page-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A small webpage for testing Smith builds and Cloudflare deployments.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  }
}
